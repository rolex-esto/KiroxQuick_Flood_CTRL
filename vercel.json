{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "vite"
    },
    "camera-proxy": {
      "root": "server",
      "runtime": "node",
      "entrypoint": "windyProxy.mjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "camera-proxy" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
